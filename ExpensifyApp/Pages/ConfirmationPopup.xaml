<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="ExpensifyApp.Pages.ConfirmationPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Border Padding="0" StrokeThickness="0" BackgroundColor="#F5F7FA"
            WidthRequest="320">
        <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
        <Border.Shadow><Shadow Brush="#40000000" Offset="0,8" Radius="24"/></Border.Shadow>

        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="0">

            <!-- ===== HEADER ===== -->
            <Grid x:Name="headerGrid" Grid.Row="0" Padding="20,16" ColumnDefinitions="Auto,*">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="gradientStart" Color="#0D8C87" Offset="0.0"/>
                        <GradientStop x:Name="gradientEnd" Color="#0A7A75" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Label x:Name="iconLabel" Text="❓" FontSize="22" VerticalOptions="Center" Margin="0,0,10,0"/>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label x:Name="titleLabel" Text="Confirm Action" TextColor="White" FontSize="18" FontAttributes="Bold"/>
                    <Label x:Name="subtitleLabel" Text="Please confirm to proceed" TextColor="#A8E6E2" FontSize="12"/>
                </VerticalStackLayout>
            </Grid>

            <!-- ===== CONTENT & MESSAGE ===== -->
            <VerticalStackLayout Grid.Row="1" Padding="20,20,20,8" Spacing="16">
                <Label x:Name="messageLabel" Text="Are you sure you want to perform this action?" 
                       TextColor="#1C2340" FontSize="14" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
            </VerticalStackLayout>

            <!-- ===== BUTTONS ===== -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" Padding="20,8,20,20" ColumnSpacing="12">
                <Button x:Name="cancelButton" Text="Cancel" BackgroundColor="#F0F3F8" TextColor="#8A94A6"
                        FontAttributes="Bold" FontSize="14" CornerRadius="12"
                        HeightRequest="46" Clicked="OnCancelClicked"/>
                <Button x:Name="confirmButton" Grid.Column="1" Text="Confirm" BackgroundColor="#0D8C87" TextColor="White"
                        FontAttributes="Bold" FontSize="14" CornerRadius="12"
                        HeightRequest="46" Clicked="OnConfirmClicked"/>
            </Grid>

        </Grid>
    </Border>
</toolkit:Popup>
