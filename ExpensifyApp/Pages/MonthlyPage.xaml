<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:micro="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="ExpensifyApp.Pages.MonthlyPage">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="15">

            <Label Text="{Binding MonthName}" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>

            <!-- Donut Chart -->
            <Frame BackgroundColor="White" CornerRadius="20" Padding="20">
                <micro:ChartView Chart="{Binding MonthlyDonutChart}" HeightRequest="320"/>
            </Frame>

            <!-- Week-wise Bar Chart -->
            <Frame BackgroundColor="White" CornerRadius="15" Padding="10">
                <micro:ChartView Chart="{Binding MonthlyBarChart}" HeightRequest="250"/>
            </Frame>

            <!-- Report (Always Visible) -->
            <Frame BackgroundColor="White" CornerRadius="15" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Monthly Report" FontSize="20" FontAttributes="Bold"/>
                    <Label Text="{Binding MonthlyTotal, StringFormat='Total: ₹{0:N0}'}" FontSize="20" TextColor="#9C27B0"/>
                    <Button Text="Download PDF" BackgroundColor="#9C27B0" TextColor="White" CornerRadius="12" Command="{Binding DownloadMonthlyPdfCommand}"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>