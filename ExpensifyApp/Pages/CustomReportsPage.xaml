<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"             x:Class="ExpensifyApp.Pages.CustomReportsPage"             Title="CustomReportsPage"             NavigationPage.HasBackButton="False"             NavigationPage.HasNavigationBar="False">    <Grid RowSpacing="15">        <Grid.RowDefinitions>            <RowDefinition Height="Auto"/>                       <RowDefinition Height="*"/>                        <RowDefinition Height="Auto"/>                    </Grid.RowDefinitions>               <Grid Grid.Row="0" ColumnSpacing="10" BackgroundColor="#49729B" Padding="5">            <Grid.ColumnDefinitions>                <ColumnDefinition Width="*" />                <ColumnDefinition Width="*" />            </Grid.ColumnDefinitions>            <VerticalStackLayout Grid.Column="0">                <Label Text="Start Date" />                <DatePicker x:Name="StartDatePicker" DateSelected="OnDateChanged" />            </VerticalStackLayout>            <VerticalStackLayout Grid.Column="1">                <Label Text="End Date" />                <DatePicker x:Name="EndDatePicker" DateSelected="OnDateChanged" />            </VerticalStackLayout>        </Grid>                <CollectionView x:Name="expenses" Grid.Row="1" SelectionMode="None">            <CollectionView.ItemTemplate>                <DataTemplate>                    <Frame BorderColor="LightGray" CornerRadius="10" Padding="10" Margin="5">                        <Grid>                            <Grid.RowDefinitions>                                <RowDefinition Height="Auto" />                                <RowDefinition Height="Auto" />                                <RowDefinition Height="Auto" />                                <RowDefinition Height="Auto" />                                <RowDefinition Height="Auto" />                                <RowDefinition Height="50" />                                                            </Grid.RowDefinitions>                            <Grid.ColumnDefinitions>                                <ColumnDefinition Width="Auto"/>                                <ColumnDefinition Width="15"/>                                <ColumnDefinition Width="*"/>                            </Grid.ColumnDefinitions>                                                       <Label Text="Date" Grid.Row="0" Grid.Column="0"  VerticalOptions="Center" />                            <Label Grid.Row="0" Grid.Column="1" Text=":" VerticalOptions="Center" />                            <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}" Grid.Row="0" Grid.Column="2" VerticalOptions="Center" />                                                      <Label Text="Category" Grid.Row="1" Grid.Column="0"  VerticalOptions="Center" />                            <Label Grid.Row="1" Grid.Column="1" Text=":" VerticalOptions="Center" />                            <Label Text="{Binding Category}" Grid.Row="1" Grid.Column="2" VerticalOptions="Center" />                                                      <Label Text="SubCategory" Grid.Row="2" Grid.Column="0"  VerticalOptions="Center" />                            <Label Grid.Row="2" Grid.Column="1" Text=":" VerticalOptions="Center" />                            <Label Text="{Binding SubCategory}" Grid.Row="2" Grid.Column="2" VerticalOptions="Center" />                                                       <Label Text="Expense" Grid.Row="3" Grid.Column="0"  VerticalOptions="Center" />                            <Label Grid.Row="3" Grid.Column="1" Text=":" VerticalOptions="Center" />                            <Label Text="{Binding Expenses, StringFormat='₹{0:F2}'}" Grid.Row="3" Grid.Column="2" VerticalOptions="Center" />                                                        <Label Text="Mode of Payment" Grid.Row="4" Grid.Column="0"  VerticalOptions="Center" />                            <Label Grid.Row="4" Grid.Column="1" Text=":" VerticalOptions="Center" />                            <Label Text="{Binding PayMode}" Grid.Row="4" Grid.Column="2" VerticalOptions="Center" />                                                        <Grid Grid.Row="5" Grid.ColumnSpan="3" ColumnDefinitions="*,*" ColumnSpacing="10" HorizontalOptions="End">                                <ImageButton Source="edit_icon.png"                                             Grid.Column="0"                                             HeightRequest="10"                                             WidthRequest="10"                                             Clicked="EditButton_Clicked"                                             CommandParameter="{Binding .}"                                             BackgroundColor="Transparent"/>                                <ImageButton Source="delete_icon.png"                                             Grid.Column="1"                                             HeightRequest="10"                                             WidthRequest="10"                                             Clicked="DeleteButton_Clicked"                                             CommandParameter="{Binding .}"                                             BackgroundColor="Transparent"/>                            </Grid>                        </Grid>                    </Frame>                </DataTemplate>            </CollectionView.ItemTemplate>        </CollectionView>                <Label x:Name="totalAmountLabel"               IsVisible="False"               Text="Total: ₹"               FontAttributes="Bold"               FontSize="20"               HorizontalOptions="End"               Margin="0,10,0,0"               Grid.Row="2" />    </Grid></ContentPage>