<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ExpensifyApp.Pages"
             x:Class="ExpensifyApp.Pages.HistoryPage"
             x:Name="thisPage"
             BackgroundColor="#F4F6FB"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===== TOP HEADER ===== -->
        <Border Grid.Row="0" StrokeThickness="0" Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,28,28"/>
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F9F99" Offset="0.0"/>
                    <GradientStop Color="#086B67" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <VerticalStackLayout Padding="20,48,20,22" Spacing="14">
                <!-- Title Row -->
                <Grid ColumnDefinitions="*">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                        <Label Text="Transaction History" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="Track every rupee you spend" TextColor="#B2F2EE" FontSize="12" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Search Bar -->
                <Border BackgroundColor="#20FFFFFF" StrokeThickness="0" Padding="14,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="🔍" FontSize="16" TextColor="#B2F2EE" VerticalOptions="Center" Margin="0,0,10,0"/>
                        <Entry x:Name="searchBar" Grid.Column="1" Placeholder="Search by category..."
                               TextColor="White" PlaceholderColor="#80FFFFFF" TextChanged="OnSearchTextChanged"
                               BackgroundColor="Transparent" VerticalOptions="Center" VerticalTextAlignment="Center"
                               ClearButtonVisibility="WhileEditing"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout>

                <!-- ===== PERIOD FILTER PILLS ===== -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="20,16,20,0">
                    <HorizontalStackLayout Spacing="10" x:Name="chipContainer">
                        <!-- All -->
                        <Border x:Name="pillAll" Padding="18,10" BackgroundColor="#0D8C87" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                            <Label Text="All" TextColor="White" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPillAll"/></Border.GestureRecognizers>
                        </Border>
                        <!-- Today -->
                        <Border x:Name="pillToday" Padding="18,10" BackgroundColor="White" StrokeThickness="1" Stroke="#E5E7EB">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="#08000000" Offset="0,1" Radius="4"/></Border.Shadow>
                            <Label Text="Today" TextColor="#1C2340" VerticalOptions="Center" FontSize="13"/>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPillToday"/></Border.GestureRecognizers>
                        </Border>
                        <!-- This Month -->
                        <Border x:Name="pillMonth" Padding="18,10" BackgroundColor="White" StrokeThickness="1" Stroke="#E5E7EB">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="#08000000" Offset="0,1" Radius="4"/></Border.Shadow>
                            <Label Text="This Month" TextColor="#1C2340" VerticalOptions="Center" FontSize="13"/>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPillMonth"/></Border.GestureRecognizers>
                        </Border>
                        <!-- Pick Date -->
                        <Border x:Name="pillDate" Padding="18,10" BackgroundColor="White" StrokeThickness="1" Stroke="#E5E7EB">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="#08000000" Offset="0,1" Radius="4"/></Border.Shadow>
                            <Grid>
                                <Label x:Name="lblDateFilter" Text="📅 Pick Date" TextColor="#1C2340" FontSize="13" VerticalOptions="Center"/>
                                <DatePicker x:Name="datePicker" Opacity="0.01" VerticalOptions="Center" DateSelected="OnFilterDateSelected"/>
                            </Grid>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPillDateTapped"/></Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- ===== SUMMARY CARDS ===== -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Padding="20,16,20,4">
                    <!-- Total Income -->
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="14,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#0A000000" Offset="0,3" Radius="10"/></Border.Shadow>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="INCOME" FontSize="10" TextColor="#8A94A6" FontAttributes="Bold" CharacterSpacing="0.8"/>
                            <Label x:Name="summaryIncomeLabel" Text="₹0" FontSize="16" FontAttributes="Bold" TextColor="#0D8C87"/>
                        </VerticalStackLayout>
                    </Border>
                    <!-- Total Spent -->
                    <Border Grid.Column="1" BackgroundColor="White" StrokeThickness="0" Padding="14,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#0A000000" Offset="0,3" Radius="10"/></Border.Shadow>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="SPENT" FontSize="10" TextColor="#8A94A6" FontAttributes="Bold" CharacterSpacing="0.8"/>
                            <Label x:Name="summarySpentLabel" Text="-₹0" FontSize="16" FontAttributes="Bold" TextColor="#E53935"/>
                        </VerticalStackLayout>
                    </Border>
                    <!-- Count -->
                    <Border Grid.Column="2" BackgroundColor="White" StrokeThickness="0" Padding="14,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#0A000000" Offset="0,3" Radius="10"/></Border.Shadow>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="COUNT" FontSize="10" TextColor="#8A94A6" FontAttributes="Bold" CharacterSpacing="0.8"/>
                            <Label x:Name="summaryCountLabel" Text="0" FontSize="16" FontAttributes="Bold" TextColor="#1C2340"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>




                <!-- ===== TRANSACTIONS HEADER + SORT ===== -->
                <Grid ColumnDefinitions="*,Auto" Padding="20,14,20,6">
                    <Label Text="Transactions" FontSize="17" FontAttributes="Bold" TextColor="#1C2340" VerticalOptions="Center"/>
                    <Border Grid.Column="1" BackgroundColor="#F0F3F8" StrokeThickness="0" Padding="10,6" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                        <Picker x:Name="sortPicker" Title="Sort" FontSize="12" TextColor="#8A94A6" SelectedIndexChanged="OnSortChanged">
                            <Picker.Items>
                                <x:String>Newest</x:String>
                                <x:String>Oldest</x:String>
                                <x:String>Highest amount</x:String>
                                <x:String>Lowest amount</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>
                </Grid>

                <!-- ===== TRANSACTION LIST ===== -->
                <CollectionView x:Name="historyList"
                                ItemsSource="{Binding GroupedHistory, Source={x:Reference thisPage}}"
                                IsGrouped="True"
                                SelectionMode="None">

                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate x:DataType="local:HistoryGroup">
                            <Grid Padding="20,10,20,6" ColumnDefinitions="*,Auto">
                                <Label Text="{Binding GroupTitle}" FontSize="13" FontAttributes="Bold" TextColor="#8A94A6" VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:HistoryExpenseItem">
                            <SwipeView>
                                <SwipeView.LeftItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Duplicate" BackgroundColor="#4CAF50"
                                                   Command="{Binding BindingContext.DuplicateCommand, Source={x:Reference thisPage}}"
                                                   CommandParameter="{Binding .}" />
                                        <SwipeItem Text="Recurring" BackgroundColor="#FF9800"
                                                   Command="{Binding BindingContext.RecurringCommand, Source={x:Reference thisPage}}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.LeftItems>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Edit" BackgroundColor="#2196F3"
                                                   Command="{Binding BindingContext.EditCommand, Source={x:Reference thisPage}}"
                                                   CommandParameter="{Binding .}" />
                                        <SwipeItem Text="Delete" BackgroundColor="#FF5252"
                                                   Command="{Binding BindingContext.DeleteCommand, Source={x:Reference thisPage}}"
                                                   CommandParameter="{Binding .}"/>
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border BackgroundColor="White" StrokeThickness="0" Padding="14,12" Margin="20,0,20,10">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                                    <Border.Shadow><Shadow Brush="#08000000" Offset="0,2" Radius="8"/></Border.Shadow>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <!-- Emoji Icon -->
                                        <Border WidthRequest="44" HeightRequest="44" BackgroundColor="{Binding IconBg}" VerticalOptions="Center" StrokeThickness="0">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                                            <Label Text="{Binding CategoryEmoji}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <!-- Details -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Category}" FontSize="14" FontAttributes="Bold" TextColor="#1C2340"/>
                                            <Label Text="{Binding SubCategoryDisplay}" FontSize="12" TextColor="#8A94A6"/>
                                            <Label Text="{Binding TimeDisplay}" FontSize="10" TextColor="#B0B8C1"/>
                                        </VerticalStackLayout>
                                        <!-- Amount -->
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="3">
                                            <Label Text="{Binding AmountDisplay}" FontSize="15" FontAttributes="Bold" TextColor="#E53935" HorizontalOptions="End"/>
                                            <Label Text="{Binding DateStr}" FontSize="10" TextColor="#B0B8C1" HorizontalOptions="End"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Border BackgroundColor="White" StrokeThickness="0" Padding="24" Margin="20,20">
                            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                                <Label Text="🧾" FontSize="52" HorizontalOptions="Center"/>
                                <Label Text="No transactions found" FontSize="17" FontAttributes="Bold" TextColor="#1C2340" HorizontalOptions="Center"/>
                                <Label Text="Try changing filters or add a new expense." FontSize="13" TextColor="#8A94A6" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== BOTTOM NAV BAR ===== -->
        <Grid Grid.Row="2" BackgroundColor="White" RowDefinitions="Auto,Auto">
            <BoxView Grid.Row="0" HeightRequest="1" BackgroundColor="#E5E7EB"/>
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Padding="0,10,0,16" BackgroundColor="White">
                <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                    <Grid WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" RowDefinitions="*,*" ColumnDefinitions="*,*" ColumnSpacing="3" RowSpacing="3">
                        <BoxView Grid.Row="0" Grid.Column="0" CornerRadius="2" Color="#8A94A6"/>
                        <BoxView Grid.Row="0" Grid.Column="1" CornerRadius="2" Color="#8A94A6"/>
                        <BoxView Grid.Row="1" Grid.Column="0" CornerRadius="2" Color="#8A94A6"/>
                        <BoxView Grid.Row="1" Grid.Column="1" CornerRadius="2" Color="#8A94A6"/>
                    </Grid>
                    <Label Text="Dashboard" FontSize="10" TextColor="#8A94A6" HorizontalOptions="Center"/>
                    <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnDashboardTapped"/></VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                    <Label Text="🕐" FontSize="22" HorizontalOptions="Center" TextColor="#0D8C87"/>
                    <Label Text="History" FontSize="10" TextColor="#0D8C87" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                    <Label Text="📊" FontSize="22" HorizontalOptions="Center" TextColor="#8A94A6"/>
                    <Label Text="Stats" FontSize="10" TextColor="#8A94A6" HorizontalOptions="Center"/>
                    <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnStatsTapped"/></VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                    <Label Text="👤" FontSize="22" HorizontalOptions="Center" TextColor="#8A94A6"/>
                    <Label Text="Profile" FontSize="10" TextColor="#8A94A6" HorizontalOptions="Center"/>
                    <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnProfileTapped"/></VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
            </Grid>

            <Border Grid.Row="0" Grid.RowSpan="2" BackgroundColor="#0D8C87" StrokeThickness="0" WidthRequest="60" HeightRequest="60" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,-30,0,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="30"/></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="#800D8C87" Offset="0,4" Radius="16"/></Border.Shadow>
                <Button Text="+" FontSize="32" TextColor="White" BackgroundColor="Transparent" HorizontalOptions="Fill" VerticalOptions="Fill" Clicked="addButton_Clicked"/>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
