<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpensifyApp.Pages.SavingsPlannerPage"
             BackgroundColor="#F4F6FB"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===== TOP HEADER ===== -->
        <Border Grid.Row="0" StrokeThickness="0" Padding="20,44,20,20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,24,24"/>
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F9F99" Offset="0.0"/>
                    <GradientStop Color="#086B67" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="12,0">
                    <Label Text="Savings &amp; Goals" TextColor="White" FontSize="20" FontAttributes="Bold"/>
                    <Label Text="Track targets &amp; save for your dreams" TextColor="#B2F2EE" FontSize="12"/>
                </VerticalStackLayout>

                <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="#33FFFFFF" Padding="12,8" VerticalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Label Text="+ Goal" TextColor="White" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddGoalClicked"/>
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

        <!-- ===== BODY CONTENT ===== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16,20,24" Spacing="20">

                <!-- ===== SECTION 1: OVERVIEW CARD ===== -->
                <Border BackgroundColor="White" StrokeThickness="0" Padding="20">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#0D000000" Offset="0,4" Radius="12"/></Border.Shadow>
                    
                    <VerticalStackLayout Spacing="16">
                        <!-- Top Total Savings -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="TOTAL SAVINGS" FontSize="11" FontAttributes="Bold" TextColor="#8A94A6" CharacterSpacing="1"/>
                                <Label x:Name="totalSavingsLabel" Text="₹0" FontSize="28" FontAttributes="Bold" TextColor="#1C2340"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="1" WidthRequest="44" HeightRequest="44" BackgroundColor="#E0F2F1" StrokeThickness="0" VerticalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                                <Label Text="💎" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#F0F3F8"/>
                        
                        <!-- Monthly Progress Grid -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                            <!-- Saved This Month -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                <Label Text="Saved This Month" FontSize="11" TextColor="#8A94A6"/>
                                <Label x:Name="savedThisMonthLabel" Text="₹0" FontSize="16" FontAttributes="Bold" TextColor="#0D8C87"/>
                            </VerticalStackLayout>
                            
                            <!-- Target Savings -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="End">
                                <Label Text="Monthly Target" FontSize="11" TextColor="#8A94A6" HorizontalOptions="End"/>
                                <Label x:Name="targetSavingsLabel" Text="₹0" FontSize="16" FontAttributes="Bold" TextColor="#1C2340" HorizontalOptions="End"/>
                            </VerticalStackLayout>

                            <!-- Remaining Target -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                                <Label Text="Remaining Target" FontSize="11" TextColor="#8A94A6"/>
                                <Label x:Name="remainingTargetLabel" Text="₹0" FontSize="14" FontAttributes="Bold" TextColor="#2196F3"/>
                            </VerticalStackLayout>

                            <!-- Overall Progress % -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" HorizontalOptions="End">
                                <Label Text="Target Achieved" FontSize="11" TextColor="#8A94A6" HorizontalOptions="End"/>
                                <Label x:Name="progressPctLabel" Text="0%" FontSize="14" FontAttributes="Bold" TextColor="#0D8C87" HorizontalOptions="End"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Progress Bar -->
                        <Border HeightRequest="10" BackgroundColor="#E5E7EB" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                            <Grid HorizontalOptions="Start">
                                <BoxView x:Name="savingsProgressBar" Color="#0D8C87" WidthRequest="4" CornerRadius="5"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- ===== SECTION: MONTHLY SALARY & SAVINGS PLAN ===== -->
                <Border BackgroundColor="White" StrokeThickness="0" Padding="18,16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#0D000000" Offset="0,4" Radius="10"/></Border.Shadow>
                    <VerticalStackLayout Spacing="14">

                        <!-- Section Title -->
                        <Grid ColumnDefinitions="Auto,*">
                            <Border WidthRequest="36" HeightRequest="36" BackgroundColor="#E8F5E9" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                <Label Text="💼" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center" Spacing="1">
                                <Label Text="Monthly Salary &amp; Plan" FontSize="15" FontAttributes="Bold" TextColor="#1C2340"/>
                                <Label Text="Set income and savings strategy for this month" FontSize="11" TextColor="#8A94A6"/>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#F0F3F8"/>

                        <!-- Monthly Salary Input -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Monthly Salary (₹)" FontSize="12" FontAttributes="Bold" TextColor="#8A94A6"/>
                            <Border BackgroundColor="#F8FAFC" StrokeThickness="1" Stroke="#E5E7EB" Padding="14,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="₹" FontSize="16" FontAttributes="Bold" TextColor="#0D8C87" VerticalOptions="Center" Margin="0,0,8,0"/>
                                    <Entry x:Name="monthlySalaryEntry" Grid.Column="1"
                                           Placeholder="Enter your salary for this month"
                                           PlaceholderColor="#B0B8C1"
                                           TextColor="#1C2340" FontSize="14"
                                           Keyboard="Numeric"
                                           BackgroundColor="Transparent"
                                           ReturnType="Done"
                                           Completed="OnSalaryEntryCompleted"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Savings Plan Chooser -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Savings Plan" FontSize="12" FontAttributes="Bold" TextColor="#8A94A6"/>
                            <Border BackgroundColor="#F8FAFC" StrokeThickness="1" Stroke="#E5E7EB" Padding="10,4">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <Picker x:Name="savingsPlanPicker"
                                        Title="Choose a savings plan..."
                                        FontSize="14" TextColor="#1C2340"
                                        TitleColor="#B0B8C1"
                                        SelectedIndexChanged="OnSavingsPlanChanged">
                                    <Picker.Items>
                                        <x:String>50/30/20 Rule — 30% Savings</x:String>
                                        <x:String>60/20/20 Rule — 20% Savings</x:String>
                                        <x:String>70/20/10 Rule — 10% Savings</x:String>
                                        <x:String>Aggressive Saver — 40% Savings</x:String>
                                        <x:String>Student Plan — 25% Savings</x:String>
                                        <x:String>Custom Plan</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Computed Savings Amount Preview -->
                        <Border x:Name="salaryPreviewBorder" BackgroundColor="#F0FDF9" StrokeThickness="1" Stroke="#B2DFDB" Padding="12,10" IsVisible="False">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                    <Label Text="Target Savings" FontSize="10" TextColor="#8A94A6" HorizontalOptions="Center"/>
                                    <Label x:Name="previewSavingsLabel" Text="₹0" FontSize="15" FontAttributes="Bold" TextColor="#0D8C87" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                                <BoxView Grid.Column="1" WidthRequest="1" BackgroundColor="#B2DFDB" VerticalOptions="FillAndExpand" Margin="0,2"/>
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                                    <Label Text="Available to Spend" FontSize="10" TextColor="#8A94A6" HorizontalOptions="Center"/>
                                    <Label x:Name="previewSpendLabel" Text="₹0" FontSize="15" FontAttributes="Bold" TextColor="#1C2340" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Apply Button -->
                        <Button x:Name="applySalaryBtn" Text="Apply &amp; Update Plan 💾"
                                BackgroundColor="#0D8C87" TextColor="White"
                                FontSize="13" FontAttributes="Bold"
                                HeightRequest="44" CornerRadius="12"
                                Clicked="OnApplySalaryPlanClicked"/>

                    </VerticalStackLayout>
                </Border>

                <!-- ===== QUICK SAVINGS ACTIONS BAR ===== -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <!-- Deposit Button -->
                    <Border Grid.Column="0" BackgroundColor="#0D8C87" StrokeThickness="0" Padding="12,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAddSavingsTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Label Text="📥" FontSize="14" VerticalOptions="Center"/>
                            <Label Text="Deposit" TextColor="White" FontAttributes="Bold" FontSize="13" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Auto Allocate Button -->
                    <Border Grid.Column="1" BackgroundColor="White" StrokeThickness="1" Stroke="#E0F2F1" Padding="10,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTransferSavingsTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="⚡" FontSize="14" VerticalOptions="Center"/>
                            <Label Text="Transfer" TextColor="#0D8C87" FontAttributes="Bold" FontSize="12" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Withdraw Button -->
                    <Border Grid.Column="2" BackgroundColor="White" StrokeThickness="1" Stroke="#FFEBEE" Padding="10,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnWithdrawSavingsTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="📤" FontSize="14" VerticalOptions="Center"/>
                            <Label Text="Withdraw" TextColor="#D32F2F" FontAttributes="Bold" FontSize="12" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- ===== SECTION 2: CURRENT STRATEGY PLAN ===== -->
                <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#0D000000" Offset="0,2" Radius="8"/></Border.Shadow>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Savings Allocation Strategy" FontSize="14" FontAttributes="Bold" TextColor="#1C2340" VerticalOptions="Center"/>
                            <Label Grid.Column="1" x:Name="currentPlanLabel" Text="50/30/20 Strategy" FontSize="12" FontAttributes="Bold" TextColor="#0D8C87" VerticalOptions="Center"/>
                        </Grid>
                        
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Border BackgroundColor="#F4FBFB" StrokeThickness="0" Padding="8,8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                    <Label Text="Savings 💰" FontSize="10" TextColor="#8A94A6"/>
                                    <Label x:Name="strategySavingsPctLabel" Text="30%" FontSize="14" FontAttributes="Bold" TextColor="#0D8C87"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" BackgroundColor="#F0F4F9" StrokeThickness="0" Padding="8,8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                    <Label Text="Commitments 🧾" FontSize="10" TextColor="#8A94A6"/>
                                    <Label x:Name="strategyCommitPctLabel" Text="50%" FontSize="14" FontAttributes="Bold" TextColor="#1565C0"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="2" BackgroundColor="#FFF5F5" StrokeThickness="0" Padding="8,8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                    <Label Text="Expenses 🎉" FontSize="10" TextColor="#8A94A6"/>
                                    <Label x:Name="strategyExpensePctLabel" Text="20%" FontSize="14" FontAttributes="Bold" TextColor="#E53935"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Button Text="Modify Savings Strategy ⚙️" BackgroundColor="#E0F2F1" TextColor="#0D8C87" FontSize="12" FontAttributes="Bold" HeightRequest="36" CornerRadius="10" Clicked="OnChangePlanClicked"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ===== SECTION 3: MY SAVINGS GOALS ===== -->
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="2" Margin="4,4,0,0">
                        <Label Text="My Savings Goals" FontSize="17" FontAttributes="Bold" TextColor="#1C2340"/>
                        <Label Text="Deposit directly into any goal" FontSize="11" TextColor="#8A94A6"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="goalsStackLayout" Spacing="12">
                        <!-- Dynamic Goal Cards inserted here in code-behind -->
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ===== SECTION 4: SMART INSIGHTS ===== -->
                <Border BackgroundColor="#FFFDE7" StrokeThickness="1" Stroke="#FFF59D" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Savings Insights 💡" FontSize="14" FontAttributes="Bold" TextColor="#F57F17"/>
                        <Label x:Name="insightLabel1" Text="You are saving 30% of your income this month, in line with your strategy." FontSize="12" TextColor="#5D4037"/>
                        <Label x:Name="insightLabel2" Text="Increase monthly savings by ₹1,000 to reach your Emergency goal faster!" FontSize="12" TextColor="#5D4037"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ===== SECTION 5: SAVINGS HISTORY ===== -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Recent Savings Logs" FontSize="16" FontAttributes="Bold" TextColor="#1C2340" Margin="4,4,0,0"/>

                    <CollectionView x:Name="savingsHistoryList" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Border BackgroundColor="White" StrokeThickness="0" Padding="20" Margin="0,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                                <Label Text="No savings transactions recorded yet." FontSize="13" TextColor="#8A94A6" HorizontalOptions="Center"/>
                            </Border>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White" StrokeThickness="0" Padding="14,12" Margin="0,0,0,8">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#E0F2F1" StrokeThickness="0" VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                            <Label Text="{Binding TypeEmoji}" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Description}" FontSize="13" FontAttributes="Bold" TextColor="#1C2340"/>
                                            <Label Text="{Binding DateStr}" FontSize="11" TextColor="#8A94A6"/>
                                        </VerticalStackLayout>
                                        
                                        <Label Grid.Column="2" Text="{Binding AmountDisplay}" FontSize="14" FontAttributes="Bold" TextColor="{Binding AmountColor}" VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Spacer -->
        <BoxView Grid.Row="2" HeightRequest="16" Color="Transparent"/>

    </Grid>
</ContentPage>
