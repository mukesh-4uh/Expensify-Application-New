<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ExpensifyApp.Pages.ReportsPopup"
             xmlns:local="clr-namespace:ExpensifyApp.Pages">

    <Border WidthRequest="250" HeightRequest="200" BackgroundColor="White"  Padding="0">
        <VerticalStackLayout Padding="10" BackgroundColor="White" Spacing="10">

            <Label Text="Reports" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>

            <Button Text="Custom Reports" BackgroundColor="#00AAEF" TextColor="White" x:Name="customReportsButton" Clicked="customReportsButton_Clicked"/>

            <Button Text="Monthly Reports" BackgroundColor="#C9C9C9" TextColor="White" x:Name="monthlyReportsButton" Clicked="monthlyReportsButton_Clicked"/>

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>