<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="ExpensifyApp.Pages.AddBorrowedPopup"
               CanBeDismissedByTappingOutsideOfPopup="False"
               Color="Transparent"
               Size="400,680">

    <Border BackgroundColor="White" StrokeThickness="0" Padding="0" WidthRequest="400">
        <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
        <Border.Shadow><Shadow Brush="#30000000" Offset="0,8" Radius="24"/></Border.Shadow>

        <Grid RowDefinitions="Auto,*">

            <!-- Header -->
            <Border Grid.Row="0" StrokeThickness="0" Padding="22,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7B2FF7" Offset="0.0"/>
                        <GradientStop Color="#3F1099" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="🤝 Log Borrowed Amount" TextColor="White" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="Track money you owe to others" TextColor="#C9B5FF" FontSize="12"/>
                </VerticalStackLayout>
            </Border>

            <!-- Form -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="22,18,22,22" Spacing="14">

                    <!-- Person Name -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Person Name *" FontSize="12" FontAttributes="Bold" TextColor="#8A94A6"/>
                        <Border BackgroundColor="#F8FAFC" StrokeThickness="1" Stroke="#E5E7EB" Padding="14,12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Entry x:Name="personNameEntry" Placeholder="e.g. Rajan Kumar" PlaceholderColor="#B0B8C1"
                                   TextColor="#1C2340" FontSize="14" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Amount -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Amount Borrowed (₹) *" FontSize="12" FontAttributes="Bold" TextColor="#8A94A6"/>
                        <Border BackgroundColor="#F8FAFC" StrokeThickness="1" Stroke="#E5E7EB" Padding="14,12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Entry x:Name="amountEntry" Placeholder="e.g. 500" PlaceholderColor="#B0B8C1"
                                   TextColor="#1C2340" FontSize="14" Keyboard="Numeric" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Relationship + Mobile (2-col) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Relationship" FontSize="12" FontAttributes="Bold" TextColor="#8A94A6"/>
                            <Border BackgroundColor="#F8FAFC" StrokeThickness="1" Stroke="#E5E7EB" Padding="6,2">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <Picker x:Name="relationshipPicker" Title="Select" FontSize="13" TextColor="#1C2340">
                                    <Picker.Items>
                                        <x:String>Friend</x:String>
                                        <x:String>Family</x:String>
                                        <x:String>Colleague</x:String>
                                        <x:String>Neighbour</x:String>
                                        <x:String>Other</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Mobile (optional)" FontSize="12" FontAttributes="Bold" TextColor="#8A94A6"/>
                            <Border BackgroundColor="#F8FAFC" StrokeThickness="1" Stroke="#E5E7EB" Padding="14,12">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <Entry x:Name="mobileEntry" Placeholder="Phone no." PlaceholderColor="#B0B8C1"
                                       TextColor="#1C2340" FontSize="13" Keyboard="Telephone" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Purpose -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Purpose" FontSize="12" FontAttributes="Bold" TextColor="#8A94A6"/>
                        <Border BackgroundColor="#F8FAFC" StrokeThickness="1" Stroke="#E5E7EB" Padding="14,12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Entry x:Name="purposeEntry" Placeholder="e.g. Food, Fuel, Medical…" PlaceholderColor="#B0B8C1"
                                   TextColor="#1C2340" FontSize="14" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Date Borrowed + Due Date (2-col) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Date Borrowed" FontSize="12" FontAttributes="Bold" TextColor="#8A94A6"/>
                            <Border BackgroundColor="#F8FAFC" StrokeThickness="1" Stroke="#E5E7EB" Padding="6,4">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <DatePicker x:Name="dateBorrowedPicker" Format="dd MMM yyyy"
                                            TextColor="#1C2340" FontSize="13"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Repay By" FontSize="12" FontAttributes="Bold" TextColor="#8A94A6"/>
                            <Border BackgroundColor="#F8FAFC" StrokeThickness="1" Stroke="#E5E7EB" Padding="6,4">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <DatePicker x:Name="dueDatePicker" Format="dd MMM yyyy"
                                            TextColor="#1C2340" FontSize="13"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Notes -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Notes (optional)" FontSize="12" FontAttributes="Bold" TextColor="#8A94A6"/>
                        <Border BackgroundColor="#F8FAFC" StrokeThickness="1" Stroke="#E5E7EB" Padding="14,12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Entry x:Name="notesEntry" Placeholder="Any extra notes…" PlaceholderColor="#B0B8C1"
                                   TextColor="#1C2340" FontSize="14" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,6,0,0">
                        <Button Grid.Column="0" Text="Cancel" BackgroundColor="#F0F3F8" TextColor="#8A94A6"
                                CornerRadius="14" FontSize="14" FontAttributes="Bold"
                                HeightRequest="50" Clicked="OnCancelClicked"/>
                        <Button Grid.Column="1" Text="Save Record" TextColor="White"
                                CornerRadius="14" FontSize="14" FontAttributes="Bold"
                                HeightRequest="50" Clicked="OnSaveClicked">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#7B2FF7" Offset="0.0"/>
                                    <GradientStop Color="#5B1ACC" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Border>
</toolkit:Popup>
