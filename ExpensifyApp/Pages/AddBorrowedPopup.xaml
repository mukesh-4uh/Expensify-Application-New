<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="ExpensifyApp.Pages.AddBorrowedPopup"
               CanBeDismissedByTappingOutsideOfPopup="False"
               Color="Transparent"
               Size="340,460">

    <Border BackgroundColor="#F7F8FC" StrokeThickness="0" Padding="0" WidthRequest="340">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="22"/>
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="#35000000" Offset="0,8" Radius="22"/>
        </Border.Shadow>


        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">


            <Border Grid.Row="0" StrokeThickness="0" Padding="18,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F9F99" Offset="0.0"/>
                        <GradientStop Color="#086B67" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22,22,0,0"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="3">
                    <Label Text="&#x1F91D; Log Borrowed Amount" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                    <Label Text="Track money you owe to others" TextColor="#B2F2EE" FontSize="11"/>
                </VerticalStackLayout>
            </Border>


            <VerticalStackLayout Grid.Row="1" Spacing="5" Padding="18,14,18,0">
                <Label Text="Person Name *" FontSize="11" FontAttributes="Bold" TextColor="#8A94A6"/>
                <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E5E7EB" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="11"/>
                    </Border.StrokeShape>
                    <Entry x:Name="personNameEntry"
                           Placeholder="Enter Name"
                           PlaceholderColor="#C0C8D4"
                           TextColor="#1C2340" FontSize="13"
                           HeightRequest="44"
                           BackgroundColor="Transparent"/>
                </Border>
            </VerticalStackLayout>


            <VerticalStackLayout Grid.Row="2" Spacing="5" Padding="18,12,18,0">
                <Label Text="Amount Borrowed (&#x20B9;) *" FontSize="11" FontAttributes="Bold" TextColor="#8A94A6"/>
                <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E5E7EB" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="11"/>
                    </Border.StrokeShape>
                    <Entry x:Name="amountEntry"
                           Placeholder="e.g. 500"
                           PlaceholderColor="#C0C8D4"
                           TextColor="#1C2340" FontSize="13"
                           Keyboard="Numeric"
                           HeightRequest="44"
                           BackgroundColor="Transparent"/>
                </Border>
            </VerticalStackLayout>


            <VerticalStackLayout Grid.Row="3" Spacing="5" Padding="18,12,18,0">
                <Label Text="Date Borrowed *" FontSize="11" FontAttributes="Bold" TextColor="#8A94A6"/>
                <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E5E7EB" Padding="12,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="11"/>
                    </Border.StrokeShape>
                    <DatePicker x:Name="dateBorrowedPicker"
                                Format="dd MMM yyyy"
                                TextColor="#1C2340"
                                FontSize="13"
                                HeightRequest="34"/>
                </Border>
            </VerticalStackLayout>


            <BoxView Grid.Row="4" HeightRequest="1" BackgroundColor="#EAECF0" Margin="18,16,18,0"/>


            <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="10" Padding="18,12,18,18">
                <Button Grid.Column="0"
                        Text="Cancel"
                        BackgroundColor="#ECEEF3"
                        TextColor="#8A94A6"
                        CornerRadius="12"
                        FontSize="13" FontAttributes="Bold"
                        HeightRequest="46"
                        Clicked="OnCancelClicked"/>
                <Button Grid.Column="1"
                        Text="Save"
                        TextColor="White"
                        CornerRadius="12"
                        FontSize="13" FontAttributes="Bold"
                        HeightRequest="46"
                        Clicked="OnSaveClicked">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0F9F99" Offset="0.0"/>
                            <GradientStop Color="#086B67" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </Grid>

        </Grid>
    </Border>
</toolkit:Popup>
