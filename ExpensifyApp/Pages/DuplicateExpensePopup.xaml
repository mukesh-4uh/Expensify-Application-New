<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="ExpensifyApp.Pages.DuplicateExpensePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Border Padding="0" StrokeThickness="0" BackgroundColor="#F5F7FA"
            WidthRequest="320">
        <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
        <Border.Shadow><Shadow Brush="#40000000" Offset="0,8" Radius="24"/></Border.Shadow>

        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="0">

            <!-- ===== HEADER ===== -->
            <Grid Grid.Row="0" Padding="20,16" ColumnDefinitions="Auto,*">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4CAF50" Offset="0.0"/>
                        <GradientStop Color="#388E3C" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Label Text="📋" FontSize="22" VerticalOptions="Center" Margin="0,0,10,0"/>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Duplicate Expense" TextColor="White" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="Create a copy of this expense" TextColor="#C8E6C9" FontSize="12"/>
                </VerticalStackLayout>
            </Grid>

            <!-- ===== CONTENT & INFO ===== -->
            <VerticalStackLayout Grid.Row="1" Padding="20,20,20,8" Spacing="16">
                <Label Text="Create a duplicate of this expense?" 
                       TextColor="#1C2340" FontSize="14" HorizontalTextAlignment="Center"/>

                <!-- Expense Details Card -->
                <Border BackgroundColor="#E8F5E9" StrokeThickness="0" Padding="14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Text="📂" FontSize="18" VerticalOptions="Center" Margin="0,0,10,0"/>
                        <Label x:Name="infoLabel" Grid.Column="1" Text="" FontSize="14"
                               FontAttributes="Bold" TextColor="#1C2340" VerticalOptions="Center"/>
                        <Label x:Name="amountLabel" Grid.Column="2" Text="" FontSize="16"
                               FontAttributes="Bold" TextColor="#388E3C" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Date Picker Field -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="DUPLICATE DATE" FontSize="11" TextColor="#8A94A6" FontAttributes="Bold"
                           CharacterSpacing="1"/>
                    <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E5E7EB"
                            Padding="12,4">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Text="📅" FontSize="16" VerticalOptions="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="datePicker" Grid.Column="1"
                                        FontSize="15" TextColor="#1C2340"
                                        MinimumDate="01/01/2020"/>
                        </Grid>
                    </Border>
                    <Label x:Name="errorLabel" IsVisible="False" TextColor="#E53935" FontSize="11" FontAttributes="Bold" Margin="4,0,0,0"/>
                    <Label Text="⚠️ Future dates are not allowed" FontSize="11" TextColor="#8A94A6"
                           Margin="4,0,0,0"/>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ===== BUTTONS ===== -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" Padding="20,8,20,20" ColumnSpacing="12">
                <Button Text="Cancel" BackgroundColor="#F0F3F8" TextColor="#8A94A6"
                        FontAttributes="Bold" FontSize="14" CornerRadius="12"
                        HeightRequest="46" Clicked="OnCancelClicked"/>
                <Button Grid.Column="1" Text="Duplicate" BackgroundColor="#388E3C" TextColor="White"
                        FontAttributes="Bold" FontSize="14" CornerRadius="12"
                        HeightRequest="46" Clicked="OnDuplicateClicked"/>
            </Grid>

        </Grid>
    </Border>
</toolkit:Popup>
