<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="ExpensifyApp.Pages.GoalCompletionPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Border Padding="0" StrokeThickness="0" BackgroundColor="White" WidthRequest="320">
        <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
        <Border.Shadow><Shadow Brush="#60000000" Offset="0,10" Radius="30"/></Border.Shadow>

        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="0">

            <!-- ===== CELEBRATORY TOP GRADIENT ===== -->
            <Grid Grid.Row="0" Padding="20,32" RowDefinitions="Auto,Auto">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFB300" Offset="0.0"/>
                        <GradientStop Color="#FF6F00" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Label Text="🏆" FontSize="56" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,0,10"/>
                <Label Grid.Row="1" Text="Goal Completed! 🎉" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
            </Grid>

            <!-- ===== STATS / DETAILS ===== -->
            <VerticalStackLayout Grid.Row="1" Padding="24" Spacing="16" HorizontalOptions="Center">
                <Label x:Name="goalNameLabel" Text="Emergency Fund" FontSize="18" FontAttributes="Bold" TextColor="#1C2340" HorizontalOptions="Center"/>
                <Label x:Name="amountSavedLabel" Text="₹2,00,000 Saved" FontSize="26" FontAttributes="Bold" TextColor="#FF6F00" HorizontalOptions="Center"/>
                <Label Text="You've successfully reached your target! Excellent job building wealth with smart saving habits." 
                       TextColor="#8A94A6" FontSize="13" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
            </VerticalStackLayout>

            <!-- ===== BUTTONS ===== -->
            <VerticalStackLayout Grid.Row="2" Padding="20,0,20,20" Spacing="10">
                <Button Text="Share Achievement ↗" BackgroundColor="#FF6F00" TextColor="White"
                        FontAttributes="Bold" FontSize="14" CornerRadius="14" HeightRequest="48" Clicked="OnShareClicked"/>
                <Button Text="Continue Saving" BackgroundColor="#F0F3F8" TextColor="#8A94A6"
                        FontAttributes="Bold" FontSize="14" CornerRadius="14" HeightRequest="48" Clicked="OnDismissClicked"/>
            </VerticalStackLayout>

        </Grid>
    </Border>
</toolkit:Popup>
