<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="ExpensifyApp.Pages.GoogleSignInPopup"
               CanBeDismissedByTappingOutsideOfPopup="False"
               Color="Transparent">

    <Border BackgroundColor="White" StrokeThickness="0" Padding="24" WidthRequest="340">
        <Border.StrokeShape><RoundRectangle CornerRadius="26"/></Border.StrokeShape>
        <Border.Shadow><Shadow Brush="#40000000" Offset="0,10" Radius="28"/></Border.Shadow>

        <VerticalStackLayout Spacing="16">

            <!-- Official Google "G" Logo -->
            <Border WidthRequest="60" HeightRequest="60" BackgroundColor="#F8F9FA" Stroke="#E8EAED" StrokeThickness="1" HorizontalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="30"/></Border.StrokeShape>
                <Image Source="google_logo.png" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- Titles -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="Sign in with Google"
                       TextColor="#202124" FontSize="20" FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Label Text="Connect your Google account to automatically back up your expenses into Google Sheets on a monthly basis."
                       TextColor="#5F6368" FontSize="12" LineBreakMode="WordWrap"
                       HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Value Highlights -->
            <Border BackgroundColor="#F8F9FA" Stroke="#E8EAED" StrokeThickness="1" Padding="14,12">
                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Text="📊" FontSize="14" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Separate tab for each month automatically created" FontSize="11" TextColor="#3C4043" VerticalOptions="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Text="🤝" FontSize="14" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Includes Borrowed and Lent money tracking" FontSize="11" TextColor="#3C4043" VerticalOptions="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Text="⚡" FontSize="14" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="One-time setup: stays connected permanently" FontSize="11" TextColor="#3C4043" VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Commercial "Sign in with Google" Button -->
            <Border x:Name="googleSignInCard"
                    BackgroundColor="White" Stroke="#747775" StrokeThickness="1"
                    HeightRequest="50" Padding="16,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="25"/></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="#18000000" Offset="0,2" Radius="6"/></Border.Shadow>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Image Source="google_logo.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Sign in with Google" TextColor="#1F1F1F" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGoogleSignInTapped"/>
                </Border.GestureRecognizers>
            </Border>

            <!-- Don't ask again toggle -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2,0,0">
                <CheckBox x:Name="dontAskAgainCheckBox" Color="#0F9F99" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="Don't show this prompt again (can sign in later in Profile)"
                       FontSize="10" TextColor="#80868B" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDontAskAgainTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Maybe Later Button -->
            <Button Text="Maybe Later"
                    BackgroundColor="Transparent"
                    TextColor="#5F6368"
                    FontSize="12" FontAttributes="Bold"
                    HeightRequest="36"
                    Padding="0"
                    Clicked="OnMaybeLaterClicked"/>

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
