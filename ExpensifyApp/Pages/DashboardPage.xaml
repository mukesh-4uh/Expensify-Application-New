<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ExpensifyApp.Pages"
             x:Class="ExpensifyApp.Pages.DashboardPage"
             x:Name="thisPage"
             BackgroundColor="#F0F3F8"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*,Auto">


        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16" Padding="0,0,0,24">
                
                <!-- ===== TEAL GRADIENT HEADER BAR ===== -->
                <Grid Padding="20,50,20,30" RowDefinitions="Auto,Auto">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F9F99" Offset="0.0"/>
                            <GradientStop Color="#0A7A75" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- Greeting + Bell -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Hello 👋" TextColor="#A8E6E2" FontSize="15"/>
                            <Label Text="Expense Tracker" TextColor="White" FontSize="26" FontAttributes="Bold" Margin="0,2,0,0"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="White" StrokeThickness="0"
                                WidthRequest="44" HeightRequest="44" VerticalOptions="Start">
                            <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="#3010CFC9" Offset="0,4" Radius="10"/></Border.Shadow>
                            <Label Text="🔔" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18"/>
                        </Border>
                    </Grid>

                    <!-- ===== HERO BUDGET CARD ===== -->
                    <Border x:Name="budgetHeroCard" Grid.Row="1" BackgroundColor="White" StrokeThickness="0" Margin="0,22,0,0" Padding="20,18" IsVisible="{Binding IsBudgetMode}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#25000000" Offset="0,8" Radius="20"/></Border.Shadow>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label x:Name="heroMonthLabel" Text="August budget" TextColor="#1C2340" FontSize="18" FontAttributes="Bold"/>
                                <Label Grid.Column="1" Text="✎" TextColor="#8A94A6" FontSize="18" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSetBudgetTapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            <Label Grid.Row="1" x:Name="heroStatusLabel" Text="On track" TextColor="#10CFC9" FontSize="14" FontAttributes="Bold"/>
                            <Label Grid.Row="2" x:Name="heroRemainingLabel" Text="₹200 left" TextColor="#1C2340" FontSize="28" FontAttributes="Bold" Margin="0,4,0,0"/>
                            <Label Grid.Row="3" x:Name="heroSpentLabel" Text="Spent ₹100 of ₹300" TextColor="#8A94A6" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- ===== HERO COMMITMENTS CARD ===== -->
                    <Border x:Name="commitmentsHeroCard" Grid.Row="1" BackgroundColor="White" StrokeThickness="0" Margin="0,22,0,0" Padding="20,18" IsVisible="{Binding IsCommitmentsMode}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#25000000" Offset="0,8" Radius="20"/></Border.Shadow>
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <Label Grid.Row="0" Text="Monthly Commitments" TextColor="#1C2340" FontSize="18" FontAttributes="Bold"/>
                            <Label Grid.Row="1" Text="Track your salary after fixed commitments and savings" TextColor="#8A94A6" FontSize="12"/>
                            
                            <Grid Grid.Row="2" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="12">
                                <!-- Income -->
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Income" TextColor="#8A94A6" FontSize="11"/>
                                    <Label x:Name="commitHeroIncomeLabel" Text="₹0" TextColor="#1C2340" FontSize="16" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <!-- Committed -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Committed" TextColor="#8A94A6" FontSize="11"/>
                                    <Label x:Name="commitHeroCommittedLabel" Text="₹0" TextColor="#1C2340" FontSize="16" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <!-- Savings target -->
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="Savings target" TextColor="#8A94A6" FontSize="11"/>
                                    <Label x:Name="commitHeroSavingsLabel" Text="₹0" TextColor="#1C2340" FontSize="16" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <!-- Available to spend (Span) -->
                                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="3" HorizontalOptions="Center" Margin="0,8,0,0" Spacing="2">
                                    <Label Text="Available to Spend" TextColor="#8A94A6" FontSize="12" HorizontalOptions="Center"/>
                                    <Label x:Name="commitHeroAvailableLabel" Text="₹0" TextColor="#0D8C87" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>




                <!-- ==================== BUDGET MODE PANELS ==================== -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsBudgetMode}">
                    
                    <!-- Safe to Spend Today -->
                    <Border BackgroundColor="#0D8C87" StrokeThickness="0" Padding="16" Margin="20,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#330D8C87" Offset="0,4" Radius="12"/></Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto">
                            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <Label Grid.Row="0" Text="Safe to spend today" TextColor="#D1F8F6" FontSize="13"/>
                                <Label Grid.Row="1" x:Name="safeDailyLabel" Text="₹13" TextColor="White" FontSize="22" FontAttributes="Bold"/>
                                <Label Grid.Row="2" Text="Based on remaining budget and days left" TextColor="#A8E6E2" FontSize="11" Margin="0,2,0,0"/>
                            </Grid>
                            <Label Grid.Column="1" Text="🛡️" FontSize="28" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <!-- Today Card -->
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="16" Margin="20,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#0D000000" Offset="0,2" Radius="10"/></Border.Shadow>
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label Text="Today" FontSize="16" FontAttributes="Bold" TextColor="#1C2340" VerticalOptions="Center"/>
                                <Border Grid.Column="1" BackgroundColor="#E8F5E9" StrokeThickness="0" Padding="8,4" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                    <Label Text="Live" TextColor="#2E7D32" FontSize="11" FontAttributes="Bold"/>
                                </Border>
                            </Grid>
                            <BoxView Grid.Row="1" HeightRequest="1" BackgroundColor="#F0F3F8"/>
                            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Border Grid.Column="0" BackgroundColor="#F8FAFC" StrokeThickness="1" Stroke="#F1F5F9" Padding="12">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Spent today" TextColor="#8A94A6" FontSize="12"/>
                                        <Label x:Name="todayTotalLabel" Text="₹2" TextColor="#0D8C87" FontSize="18" FontAttributes="Bold"/>
                                        <Label x:Name="todayTransactionsLabel" Text="1 transaction" TextColor="#8A94A6" FontSize="11"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="#F8FAFC" StrokeThickness="1" Stroke="#F1F5F9" Padding="12">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Remaining" TextColor="#8A94A6" FontSize="12"/>
                                        <Label x:Name="remainingTotalLabel" Text="₹298" TextColor="#2196F3" FontSize="18" FontAttributes="Bold"/>
                                        <Label x:Name="remainingStatusLabel" Text="Budget available" TextColor="#8A94A6" FontSize="11"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- This Month Card -->
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="16" Margin="20,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#0D000000" Offset="0,2" Radius="10"/></Border.Shadow>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label Text="This month" FontSize="16" FontAttributes="Bold" TextColor="#1C2340" VerticalOptions="Center"/>
                                <Label x:Name="breakdownPeriodLabel" Grid.Column="1" Text="August 2026" TextColor="#10CFC9" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                            </Grid>
                            <BoxView Grid.Row="1" HeightRequest="1" BackgroundColor="#F0F3F8"/>
                            <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Transactions" TextColor="#8A94A6" FontSize="12"/>
                                    <Label x:Name="monthTransactionsLabel" Text="4" TextColor="#1C2340" FontSize="16" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Avg/day" TextColor="#8A94A6" FontSize="12"/>
                                    <Label x:Name="dailyAvgLabel" Text="₹377" TextColor="#1C2340" FontSize="16" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="4">
                                    <Label Text="Highest" TextColor="#8A94A6" FontSize="12"/>
                                    <Label x:Name="highestExpenseCategoryLabel" Text="Education" TextColor="#E53935" FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                    <Label x:Name="highestExpenseAmountLabel" Text="₹5,656" TextColor="#1C2340" FontSize="14" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView Grid.Row="3" HeightRequest="1" BackgroundColor="#F0F3F8"/>
                            <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                                <Label Text="Monthly trend" TextColor="#8A94A6" FontSize="13" VerticalOptions="Center"/>
                                <Border Grid.Column="1" BackgroundColor="#F1F5F9" StrokeThickness="0" Padding="8,4" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                    <Label x:Name="monthTrendLabel" Text="N/A" TextColor="#1C2340" FontSize="11" FontAttributes="Bold"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- ==================== COMMITMENTS MODE PANELS ==================== -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsCommitmentsMode}" Padding="20,0">
                    
                    <!-- Upcoming Commitments widget -->
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#0D000000" Offset="0,2" Radius="10"/></Border.Shadow>
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Upcoming Commitments" FontSize="15" FontAttributes="Bold" TextColor="#1C2340" VerticalOptions="Center"/>
                                <Label x:Name="commitProgressLabel" Grid.Column="1" Text="0/0 paid" FontSize="12" TextColor="#8A94A6" VerticalOptions="Center"/>
                            </Grid>
                            
                            <!-- Commitments Progress Bar -->
                            <Border HeightRequest="6" BackgroundColor="#E5E7EB" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="3"/></Border.StrokeShape>
                                <Grid HorizontalOptions="Start">
                                    <BoxView x:Name="commitProgressBar" Color="#0D8C87" WidthRequest="4" CornerRadius="3"/>
                                </Grid>
                            </Border>

                            <BoxView HeightRequest="1" BackgroundColor="#F0F3F8"/>
                            
                            <!-- In-line commitments list -->
                            <VerticalStackLayout x:Name="dashboardCommitmentsStack" Spacing="8">
                                <!-- Populated dynamically in code-behind -->
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <!-- ==================== COMMON WIDGETS ==================== -->
                <VerticalStackLayout Spacing="16" Padding="20,0">
                    
                    <!-- Savings Planner Target Widget -->
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#0D000000" Offset="0,2" Radius="10"/></Border.Shadow>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSavingsCardTapped"/></Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label Text="Savings Planner" FontSize="15" FontAttributes="Bold" TextColor="#0D8C87" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="→" TextColor="#8A94A6" FontSize="18" VerticalOptions="Center"/>
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                <Label Text="Target savings" FontSize="12" TextColor="#8A94A6"/>
                                <Label Grid.Column="1" x:Name="commitSavingsProgressLabel" Text="Saved ₹0 of ₹0" FontSize="12" TextColor="#8A94A6" HorizontalOptions="End"/>
                            </Grid>
                            <!-- Progress Bar -->
                            <Border Grid.Row="2" HeightRequest="8" BackgroundColor="#E5E7EB" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                                <Grid HorizontalOptions="Start">
                                    <BoxView x:Name="commitSavingsProgressBar" Color="#0D8C87" WidthRequest="4" CornerRadius="4"/>
                                </Grid>
                            </Border>
                            <Label Grid.Row="3" x:Name="commitSavingsRemainingLabel" Text="₹0 remaining to reach goal" FontSize="11" TextColor="#8A94A6"/>
                        </Grid>
                    </Border>

                    <!-- Lending & Recovery Widget -->
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#0D000000" Offset="0,2" Radius="10"/></Border.Shadow>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnLendingCardTapped"/></Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label Text="Lending &amp; Recovery" FontSize="15" FontAttributes="Bold" TextColor="#1565C0" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="→" TextColor="#8A94A6" FontSize="18" VerticalOptions="Center"/>
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="*,*">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="Total Outstanding" FontSize="11" TextColor="#8A94A6"/>
                                    <Label x:Name="commitLendingOutstandingLabel" Text="₹0" FontSize="18" FontAttributes="Bold" TextColor="#1C2340"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                    <Label Text="Expected Recovery" FontSize="11" TextColor="#8A94A6" HorizontalOptions="End"/>
                                    <Label x:Name="commitLendingRecoveryLabel" Text="₹0" FontSize="18" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- ==================== COMMON SECTIONS ==================== -->
                
                <!-- Recent Transactions Header -->
                <Grid ColumnDefinitions="*,Auto" Padding="20,8,20,0">
                    <Label Text="Recent Transactions" FontSize="18" FontAttributes="Bold" TextColor="#1C2340"/>
                    <Label Grid.Column="1" Text="See All" TextColor="#10CFC9" FontSize="13"
                           FontAttributes="Bold" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSeeAllTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Recent Transactions List -->
                <CollectionView x:Name="recentTransactionsList"
                                ItemsSource="{Binding RecentTransactions, Source={x:Reference thisPage}}"
                                SelectionMode="None" Margin="20,4,20,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:DashboardExpenseItem">
                            <Border BackgroundColor="White" StrokeThickness="0" Padding="14" Margin="0,0,0,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                                <Border.Shadow><Shadow Brush="#0D000000" Offset="0,2" Radius="10"/></Border.Shadow>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border WidthRequest="46" HeightRequest="46"
                                            BackgroundColor="{Binding IconBg}"
                                            VerticalOptions="Center" Margin="0,0,12,0">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                                        <Label Text="{Binding CategoryEmoji}" FontSize="20"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="2" VerticalOptions="Center">
                                        <Label Grid.Row="0" Text="{Binding TitleDisplay}" FontSize="15" FontAttributes="Bold" TextColor="#1C2340"/>
                                        <Label Grid.Row="1" Text="{Binding SubtitleDisplay}" FontSize="12" TextColor="#8A94A6"/>
                                    </Grid>
                                    <Grid Grid.Column="2" RowDefinitions="Auto,Auto" RowSpacing="2" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Grid.Row="0" Text="{Binding AmountDisplay}" FontSize="16" FontAttributes="Bold" TextColor="#E53935" HorizontalOptions="End"/>
                                        <Label Grid.Row="1" Text="{Binding DateDisplay}" FontSize="11" TextColor="#B0B8C1" HorizontalOptions="End"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Empty State -->
                <VerticalStackLayout x:Name="emptyState" IsVisible="False"
                                     HorizontalOptions="Center" Spacing="10" Padding="20,20">
                    <Border BackgroundColor="#EAF6F5" StrokeThickness="0"
                            WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="40"/></Border.StrokeShape>
                        <Label Text="💰" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="No expenses yet" FontSize="16" FontAttributes="Bold"
                           TextColor="#1C2340" HorizontalOptions="Center" Margin="0,8,0,0"/>
                    <Label Text="Tap + to add your first expense"
                           FontSize="13" TextColor="#8A94A6" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Smart Insight Banner -->
                <Border BackgroundColor="#EAF6F5" StrokeThickness="0" Padding="16" Margin="20,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="💡" FontSize="24" VerticalOptions="Start" Margin="0,0,12,0"/>
                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <Label Grid.Row="0" Text="Smart insight" FontSize="14" FontAttributes="Bold" TextColor="#0D8C87"/>
                            <Label Grid.Row="1" x:Name="smartInsightLabel" Text="..." TextColor="#1C2340" FontSize="12" LineBreakMode="WordWrap"/>
                        </Grid>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== BOTTOM NAV BAR ===== -->
        <Grid Grid.Row="1" BackgroundColor="White" RowDefinitions="Auto,Auto">

            <!-- Top divider line -->
            <BoxView Grid.Row="0" HeightRequest="1" BackgroundColor="#E5E7EB"/>

            <!-- Nav icons -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Padding="0,10,0,16" BackgroundColor="White">
                <!-- Dashboard (active) -->
                <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                    <Grid WidthRequest="22" HeightRequest="22" HorizontalOptions="Center"
                          RowDefinitions="*,*" ColumnDefinitions="*,*" ColumnSpacing="3" RowSpacing="3">
                        <BoxView Grid.Row="0" Grid.Column="0" CornerRadius="2" Color="#0D8C87"/>
                        <BoxView Grid.Row="0" Grid.Column="1" CornerRadius="2" Color="#0D8C87"/>
                        <BoxView Grid.Row="1" Grid.Column="0" CornerRadius="2" Color="#0D8C87"/>
                        <BoxView Grid.Row="1" Grid.Column="1" CornerRadius="2" Color="#0D8C87"/>
                    </Grid>
                    <Label Text="Dashboard" FontSize="10" TextColor="#0D8C87"
                           FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <!-- History -->
                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                    <Label Text="🕐" FontSize="22" HorizontalOptions="Center" TextColor="#8A94A6"/>
                    <Label Text="History" FontSize="10" TextColor="#8A94A6" HorizontalOptions="Center"/>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHistoryTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
                <!-- Stats -->
                <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                    <Label Text="📊" FontSize="22" HorizontalOptions="Center" TextColor="#8A94A6"/>
                    <Label Text="Stats" FontSize="10" TextColor="#8A94A6" HorizontalOptions="Center"/>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStatsTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                    <Label Text="👤" FontSize="22" HorizontalOptions="Center" TextColor="#8A94A6"/>
                    <Label Text="Profile" FontSize="10" TextColor="#8A94A6" HorizontalOptions="Center"/>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
            </Grid>


            <Border Grid.Row="0" Grid.RowSpan="2"
                    BackgroundColor="#0D8C87" StrokeThickness="0"
                    WidthRequest="60" HeightRequest="60"
                    HorizontalOptions="Center" VerticalOptions="Start"
                    Margin="0,-30,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#800D8C87" Offset="0,4" Radius="16"/>
                </Border.Shadow>
                <Button Text="+" FontSize="32" TextColor="White" BackgroundColor="Transparent"
                       HorizontalOptions="Fill" VerticalOptions="Fill" Clicked="addButton_Clicked"/>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
