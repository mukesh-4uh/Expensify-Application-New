<?xml version="1.0" encoding="utf-8" ?>
<local:ACSBasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpensifyApp.Pages.LoginPage"
             xmlns:local="clr-namespace:ExpensifyApp.Pages"
             BackgroundImageSource="login_background.png"
             NavigationPage.HasBackButton="False"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="20" Padding="20,45,20,20">
            
            <!-- Row 0: Logo -->
            <Image Source="logo.png" Grid.Row="0" HeightRequest="100" HorizontalOptions="Center" Margin="0,10,0,10" />

            <!-- Row 1: Login Card -->
            <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" Margin="10,0,10,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.1" />
                </Border.Shadow>
                
                <VerticalStackLayout Padding="24" Spacing="16">
                    <Label Text="Welcome Back" FontSize="26" FontAttributes="Bold" TextColor="#1C2E35" HorizontalOptions="Center" />
                    <Label Text="Authorize to access your account" FontSize="14" TextColor="#7F8C8D" HorizontalOptions="Center" Margin="0,0,0,10" />
                    
                    <!-- Beautiful Biometric Icon Container -->
                    <Border StrokeThickness="0" BackgroundColor="#F0FBFB" WidthRequest="100" HeightRequest="100" HorizontalOptions="Center" Margin="0,10,0,15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="50" />
                        </Border.StrokeShape>
                        <Image Source="fingerprint_auth_icon.png" WidthRequest="60" HeightRequest="60" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    
                    <!-- Fingerprint Button -->
                    <Button x:Name="fingerPrintButton" Text="Login with Fingerprint" BackgroundColor="#10CFC9" TextColor="White" FontAttributes="Bold" FontSize="16" HeightRequest="50" CornerRadius="25" Clicked="fingerPrintButton_Clicked" />
                    
                    <!-- OR Divider -->
                    <Grid x:Name="dividerGrid" ColumnDefinitions="*,Auto,*" ColumnSpacing="10" VerticalOptions="Center" Margin="0,5">
                        <BoxView HeightRequest="1" Color="#BDC3C7" VerticalOptions="Center" Grid.Column="0" />
                        <Label Text="OR" TextColor="#7F8C8D" FontSize="12" FontAttributes="Bold" Grid.Column="1" VerticalOptions="Center" />
                        <BoxView HeightRequest="1" Color="#BDC3C7" VerticalOptions="Center" Grid.Column="2" />
                    </Grid>
                    
                    <!-- Screen Lock Button -->
                    <Button x:Name="screenLockButton" Text="Use Screen Lock (PIN/Pattern)" BackgroundColor="Transparent" BorderColor="#10CFC9" BorderWidth="2" TextColor="#10CFC9" FontAttributes="Bold" FontSize="16" HeightRequest="50" CornerRadius="25" Clicked="screenLockButton_Clicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Row 2: Bottom illustration and copyrights -->
            <VerticalStackLayout Grid.Row="2" Spacing="15" HorizontalOptions="Center" VerticalOptions="End">
                <Image Source="piggy_bank.png" HeightRequest="110" HorizontalOptions="Center" />
                <Label Text="Copyrights @ Mukesh Muthazhagan" TextColor="Black" FontSize="12" HorizontalOptions="Center" />
            </VerticalStackLayout>
            
        </Grid>
    </ScrollView>
</local:ACSBasePage>
