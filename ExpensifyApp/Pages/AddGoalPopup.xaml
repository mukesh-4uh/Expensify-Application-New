<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="ExpensifyApp.Pages.AddGoalPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Border Padding="0" StrokeThickness="0" BackgroundColor="#F8FAFC" WidthRequest="340">
        <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
        <Border.Shadow><Shadow Brush="#50000000" Offset="0,10" Radius="24"/></Border.Shadow>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="0">

            <!-- ===== HEADER ===== -->
            <Grid Grid.Row="0" Padding="20,18" ColumnDefinitions="Auto,*">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F9F99" Offset="0.0"/>
                        <GradientStop Color="#086B67" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Border WidthRequest="40" HeightRequest="40" BackgroundColor="#33FFFFFF" StrokeThickness="0" VerticalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Label Text="🎯" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Margin="12,0,0,0">
                    <Label Text="New Savings Goal" TextColor="White" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="Set a target to save towards" TextColor="#B2F2EE" FontSize="12"/>
                </VerticalStackLayout>
            </Grid>

            <!-- ===== FORM FIELDS ===== -->
            <ScrollView Grid.Row="1" HeightRequest="320">
                <VerticalStackLayout Padding="20,16" Spacing="14">

                    <!-- Goal Name -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="GOAL TITLE" FontSize="11" TextColor="#8A94A6" FontAttributes="Bold" CharacterSpacing="1"/>
                        <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E2E8F0" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Text="✏️" FontSize="15" VerticalOptions="Center" Margin="0,0,8,0"/>
                                <Entry x:Name="nameEntry" Grid.Column="1" Placeholder="e.g. Goa Trip, New Phone, Car"
                                       PlaceholderColor="#94A3B8" FontSize="14" TextColor="#1E293B"
                                       BackgroundColor="Transparent" HeightRequest="44" VerticalTextAlignment="Center"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Target Amount -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="TARGET AMOUNT" FontSize="11" TextColor="#8A94A6" FontAttributes="Bold" CharacterSpacing="1"/>
                        <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E2E8F0" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Text="₹" FontSize="18" TextColor="#0D8C87" FontAttributes="Bold" VerticalOptions="Center" Margin="2,0,8,0"/>
                                <Entry x:Name="targetAmountEntry" Grid.Column="1" Keyboard="Numeric"
                                       Placeholder="e.g. 50000" PlaceholderColor="#94A3B8"
                                       FontSize="15" TextColor="#1E293B" BackgroundColor="Transparent"
                                       HeightRequest="44" VerticalTextAlignment="Center"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Category Icon Picker -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ICON CATEGORY" FontSize="11" TextColor="#8A94A6" FontAttributes="Bold" CharacterSpacing="1"/>
                        <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E2E8F0" Padding="12,4">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Text="🎨" FontSize="15" VerticalOptions="Center" Margin="0,0,8,0"/>
                                <Picker x:Name="iconPicker" Grid.Column="1" Title="Choose Icon"
                                        FontSize="14" TextColor="#1E293B" TitleColor="#94A3B8"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Target Date -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="TARGET DATE / DEADLINE" FontSize="11" TextColor="#8A94A6" FontAttributes="Bold" CharacterSpacing="1"/>
                        <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E2E8F0" Padding="12,4">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Text="📅" FontSize="15" VerticalOptions="Center" Margin="0,0,8,0"/>
                                <DatePicker x:Name="deadlinePicker" Grid.Column="1" FontSize="14" TextColor="#1E293B"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Auto Allocation Pct -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="AUTO-ALLOCATION (% OF MONTHLY SAVINGS)" FontSize="11" TextColor="#8A94A6" FontAttributes="Bold" CharacterSpacing="1"/>
                        <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E2E8F0" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Text="%" FontSize="16" TextColor="#0D8C87" FontAttributes="Bold" VerticalOptions="Center" Margin="2,0,8,0"/>
                                <Entry x:Name="allocationEntry" Grid.Column="1" Keyboard="Numeric"
                                       Placeholder="0 to 100 (Optional)" PlaceholderColor="#94A3B8"
                                       FontSize="14" TextColor="#1E293B" BackgroundColor="Transparent"
                                       HeightRequest="44" VerticalTextAlignment="Center"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ===== ERROR MSG ===== -->
            <Label x:Name="errorLabel" Grid.Row="2" IsVisible="False"
                   Text="" TextColor="#E53935" FontSize="12" FontAttributes="Bold"
                   Padding="20,0,20,8" HorizontalTextAlignment="Center"/>

            <!-- ===== BUTTONS ===== -->
            <Grid Grid.Row="3" ColumnDefinitions="*,*" Padding="20,8,20,20" ColumnSpacing="12">
                <Button Text="Cancel" BackgroundColor="#F1F5F9" TextColor="#64748B"
                        FontAttributes="Bold" FontSize="14" CornerRadius="12"
                        HeightRequest="46" Clicked="OnCancelClicked"/>
                <Button Grid.Column="1" Text="Create Goal ✨" BackgroundColor="#0D8C87" TextColor="White"
                        FontAttributes="Bold" FontSize="14" CornerRadius="12"
                        HeightRequest="46" Clicked="OnCreateClicked"/>
            </Grid>

        </Grid>
    </Border>
</toolkit:Popup>
